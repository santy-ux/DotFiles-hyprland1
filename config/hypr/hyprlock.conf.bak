$font = Roboto Mono
source = ~/.config/hypr/hyprlock-colors.conf

general {
    hide_cursor = false
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    path = screenshot
    blur_passes = 3
    blur_size = 5
    color = rgba(0, 0, 0, 0.5) # Oscurece un poco el fondo para resaltar las letras
}

input-field {
    monitor =
    size = 20%, 5%
    outline_thickness = 3
    inner_color = rgba(0, 0, 0, 0.3) # Ligeramente oscuro para que se vea el campo
    outer_color = $lock_outline
    check_color = $lock_check
    fail_color = $lock_fail
    font_color = $lock_font
    fade_on_empty = false
    rounding = 25
    font_family = $font
    placeholder_text = <i>Ingresa tu contraseña...</i>
    fail_text = $PAMFAIL
    dots_size = 0.2
    dots_spacing = 0.3
    position = 0, 0
    halign = center
    valign = center
}

# TIME
label {
    monitor =
    text = $TIME
    font_size = 60
    font_family = $font
    color = $lock_time
    position = 0, -130
    halign = center
    valign = top
}

# DATE
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B %Y"
    font_size = 16
    font_family = $font
    color = $lock_date
    position = 0, -250
    halign = center
    valign = top
}

# KEYBOARD LAYOUT (Corregido para tu teclado latam)
label {
    monitor =
    text = $LAYOUT
    font_size = 14
    font_family = $font
    color = $lock_layout
    position = 0, -70
    halign = center
    valign = center
}

# MUSIC PLAYER INFO
label {
    text = cmd[update:1] ~/.config/hypr/scripts/now-playing.sh
    position = 0, -300
    halign = center
    valign = center
    font_size = 15
    color = $lock_date
}

label {
    text = cmd[update:1] ~/.config/hypr/scripts/now-playing.sh previous
    position = -40, -370
    halign = center
    valign = center
    font_size = 28
    onclick = playerctl --player="$(~/.config/waybar/scripts/playerctl-active.sh)" previous
    color = $lock_date
}

label {
    text = cmd[update:1] ~/.config/hypr/scripts/now-playing.sh pause
    position = 0, -370
    halign = center
    valign = center
    font_size = 28
    onclick = playerctl --player="$(~/.config/waybar/scripts/playerctl-active.sh)" play-pause
    color = $lock_date
}

label {
    text = cmd[update:1] ~/.config/hypr/scripts/now-playing.sh next
    position = 40, -370
    halign = center
    valign = center
    font_size = 28
    onclick = playerctl --player="$(~/.config/waybar/scripts/playerctl-active.sh)" next
    color = $lock_date
}

label {
    text = cmd[update:1] ~/.config/hypr/scripts/password-cursor.sh
    position = 0, 2
    halign = center
    valign = center
    font_size = 18
    font_family = $font
    color = $lock_date
}
