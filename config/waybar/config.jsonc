{
    "layer": "top",
    "height": 30,
    "margin-top": 2,
    "position": "top",
    "exclusive": true,
    "spacing": 0,

    "exclusive": false,
    "modules-left": 1140,
    "modules-center": [],
    "modules-right": ["network", "bluetooth", "battery", "custom/power"],

    "cpu": {
        "interval": 1,
        "format": "CPU {usage}%"
    },

    "memory": {
        "interval": 1,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used} / {total}GiB"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu_usage.sh",
        "format": "GPU {}%",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Skylake-H GT2: {}%"
    },
    
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,

        "format": "{icon}",

        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'"

    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },

    "custom/mpris-marquee": {
        "exec": "~/.config/waybar/scripts/mpris-marquee.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" play-pause",
        "on-click-right": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" next",
        "on-click-middle": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" previous"
    },

    "custom/spacer": {
    "format": " ",
    "tooltip": false
   },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip": false,
        "on-click": "qs ipc call settings sound",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ifname}\n{essid}\nSignal: {signalStrength}%",
        "on-click": "qs ipc call settings network"
    },

        "bluetooth": {
            "format": "󰂯",
            "format-off": "󰂲",
            "format-connected": "󰂱",
            "tooltip-format": "{status}"
        },
        
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "",
        "format-alt": "{icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "Batería: {capacity}%\nTiempo restante: {time}"    
    },
     
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "$HOME/.config/hypr/scripts/wlogout.sh"
    }
}
